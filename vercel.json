{
  "headers": [
    {
      "source": "/main.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/config.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
